# Stockwise Environment Variables
# Copy this file to .env and fill in your actual values from your Supabase dashboard:
# https://supabase.com/dashboard/project/_/settings/api

# Supabase Project URL (found in Project Settings -> API -> Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (found in Project Settings -> API -> Project API keys -> anon public)
# Safe to embed in mobile client because access is restricted via Row Level Security (RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Environment label
EXPO_PUBLIC_APP_ENV=production
